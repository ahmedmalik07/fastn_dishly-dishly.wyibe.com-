@@ -877,3 +881,50 @@ model PaymentCheckout {
   @@index([restaurantId, createdAt])
   @@index([orderId])
 }
+
+/**
+ * dish.ly Connect: one row per restaurant that has opened the Integrations
+ * page. Each restaurant is its own Fastn customer (tenant), so the accounts it
+ * connects (HubSpot, Slack, Google...) are never visible to any other
+ * restaurant. The defaults below are the "configuration template" a new
+ * restaurant starts from.
+ */
+model IntegrationSettings {
+  id                       String     @id @default(cuid())
+  restaurantId             String     @unique
+  restaurant               Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
+  // Fastn customer (end org) UUID for this restaurant. Null until provisioned.
+  fastnEndOrgId            String?
+  enabled                  Boolean    @default(true)
+  // Orders at or above this total raise a manager alert (cents). 10,000.00
+  bigOrderThresholdCents   Int        @default(1000000)
+  slackChannel             String     @default("#general")
+  sheetName                String     @default("dish.ly daily sales")
+  ownerEmail               String?
+  sendCustomersToCrm       Boolean    @default(true)
+  sendShiftReports         Boolean    @default(true)
+  sendKhataReminders       Boolean    @default(true)
+  createdAt                DateTime   @default(now())
+  updatedAt                DateTime   @updatedAt
+}
+
+/**
+ * Outbox of everything dish.ly handed to Fastn for a restaurant. Gives the
+ * owner a visible sync history, and lets a failed delivery be retried from
+ * the Integrations page instead of being lost.
+ */
+model IntegrationEvent {
+  id           String     @id @default(cuid())
+  restaurantId String
+  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
+  type         String     // order.paid | order.cancelled | order.refunded | shift.closed | khata.reminder | test.ping
+  payload      Json
+  status       String     @default("PENDING") // PENDING | SENT | FAILED | SKIPPED
+  attempts     Int        @default(0)
+  lastError    String?
+  executionId  String?
+  createdAt    DateTime   @default(now())
+  sentAt       DateTime?
+
+  @@index([restaurantId, createdAt])
+}
